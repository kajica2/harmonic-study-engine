# VITE_OPENROUTER_API_KEY — enables cloud AI etude generators via OpenRouter
# (Gemini, MiniMax, and other models). Get a key at https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=""

# VITE_GROK_API_KEY — x.ai Grok direct API. Get a key at https://console.x.ai
VITE_GROK_API_KEY=""

# VITE_GEMINI_API_KEY — Google AI Studio direct API. Get a key at https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=""

# VITE_ANTHROPIC_API_KEY — Anthropic Claude. Get a key at https://console.anthropic.com/
VITE_ANTHROPIC_API_KEY=""

# VITE_COHERE_API_KEY — Cohere command models. Get a key at https://dashboard.cohere.com/
VITE_COHERE_API_KEY=""

# VITE_OLLAMA_URL — Self-hosted Ollama. Set to your local/server URL.
# VITE_OLLAMA_URL="http://localhost:11434/api/chat"

# VITE_DDSP_API — base URL of the DDSP synthesis backend. Only
# needed if you want the offline chord-progression render and FFT
# reverb paths (requires the optional server/requirements-ddsp.txt
# install on top of the venv). Defaults to http://127.0.0.1:8765
# when unset, which is what `bash dev.sh` boots. Set this if your
# backend lives elsewhere (LAN IP, a tunnel, etc.).
# VITE_DDSP_API="http://127.0.0.1:8765"

# Marketplace backend (server/marketplace.py). MARKETPLACE_DB_PATH is the
# sqlite file used for listing storage (schema created at server import).
# MARKETPLACE_WEBHOOK_SECRET is the HMAC-SHA256 secret used to verify
# GitHub webhook signatures (X-Hub-Signature-256). Leave unset to fail
# closed (503) on webhook requests. MARKETPLACE_WEBHOOK_BRANCH gates
# which branch's pushes are ingested (default refs/heads/main).
MARKETPLACE_DB_PATH="./marketplace.db"
MARKETPLACE_WEBHOOK_SECRET=""
MARKETPLACE_WEBHOOK_BRANCH="refs/heads/main"